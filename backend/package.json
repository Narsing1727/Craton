{
  "name": "craton-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Craton API, storage engine, checks runner and CLI.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "craton": "bin/craton.js"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "setup:oauth": "node --disable-warning=ExperimentalWarning scripts/setup-oauth.ts",
    "craton": "node --disable-warning=ExperimentalWarning src/cli/craton.ts",
    "mcp": "node --disable-warning=ExperimentalWarning src/mcp/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:matrix": "node --disable-warning=ExperimentalWarning --test test/filematrix.matrix.ts",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.ts",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.ts",
    "migrate-sqlite": "node --disable-warning=ExperimentalWarning scripts/migrate-sqlite.ts",
    "gc": "node --disable-warning=ExperimentalWarning scripts/gc.ts",
    "repack": "node --disable-warning=ExperimentalWarning scripts/repack.ts",
    "recode": "node --disable-warning=ExperimentalWarning scripts/recode.ts",
    "fsck": "node --disable-warning=ExperimentalWarning scripts/fsck.ts",
    "load": "node scripts/load.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@hono/node-server": "^2.1.3",
    "@node-saml/node-saml": "5.1.0",
    "colormap": "2.3.2",
    "epsg-index": "2.0.0",
    "hono": "^4.13.11",
    "ioredis": "5.11.1",
    "pako": "2.1.0",
    "pg": "8.13.1",
    "proj4": "2.22.0"
  },
  "devDependencies": {
    "@types/colormap": "2.3.4",
    "@types/node": "^26.6.3",
    "@types/pako": "2.0.3",
    "@types/pg": "8.11.10",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3"
  }
}
