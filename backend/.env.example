# Copy to .env (same folder). Real environment variables win over this file. See ../OPERATING.md for every setting.

# "Continue with Google": create an OAuth client (Web application) in Google Cloud Console and allow
# the redirect URI  <your site>/auth/google/callback
# CRATON_GOOGLE_CLIENT_ID=
# CRATON_GOOGLE_CLIENT_SECRET=

# "Continue with GitHub": GitHub Settings -> Developer settings -> OAuth Apps; callback  <your site>/auth/github/callback
# CRATON_GITHUB_CLIENT_ID=
# CRATON_GITHUB_CLIENT_SECRET=

# The public address of the web app (used in emails, redirects and passkeys)
# CRATON_WEB_URL=https://craton.nerolith.in
